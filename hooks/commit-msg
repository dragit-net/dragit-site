#!/bin/sh
# Block commit messages that mention the agent stack or the wrong identity.
#
# Owner order 2026-10-02: no Freebuff / Codebuff / bitno2u data may ever enter a
# commit - not in the subject, not in the body, not in trailers.
MSG_FILE="$1"
BAD="codebuff|freebuff|bitno2u|generated with|co-authored-by:[[:space:]]*codebuff|🤖"

if grep -Eiq "$BAD" "$MSG_FILE" 2>/dev/null; then
    echo "" >&2
    echo "  BLOKIRANO: poruka commita sadrzi zabranjen trag (Freebuff / Codebuff / bitno2u)." >&2
    echo "  poruka mora opisati samo promenu u sajun/projektu, bez alata i naloga koji su je napisali." >&2
    echo "" >&2
    grep -Ein "$BAD" "$MSG_FILE" | sed 's/^/    /' >&2
    echo "" >&2
    exit 1
fi
exit 0